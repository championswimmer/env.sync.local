#!/bin/bash
set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PREFIX_DIR="$(cd "$SELF_DIR/.." && pwd)"
CMD_NAME="$(basename "$0")"

GO_BIN="${ENV_SYNC_GO_BIN:-}"
LEGACY_DIR="${ENV_SYNC_LEGACY_DIR:-}"

if [[ -z "$LEGACY_DIR" ]]; then
    for candidate in "$PREFIX_DIR/legacy" "$PREFIX_DIR/lib/env-sync/legacy"; do
        if [[ -d "$candidate" ]]; then
            LEGACY_DIR="$candidate"
            break
        fi
    done
fi

if [[ -z "$GO_BIN" ]]; then
    for candidate in "$PREFIX_DIR/target/env-sync" "$PREFIX_DIR/lib/env-sync/env-sync-go" "$PREFIX_DIR/lib/env-sync/env-sync"; do
        if [[ -x "$candidate" ]]; then
            GO_BIN="$candidate"
            break
        fi
    done
fi

if [[ "${ENV_SYNC_USE_BASH:-}" == "true" ]]; then
    if [[ -n "$LEGACY_DIR" ]] && [[ -x "$LEGACY_DIR/bin/$CMD_NAME" ]]; then
        exec "$LEGACY_DIR/bin/$CMD_NAME" "$@"
    fi
    echo "Legacy bash command not found for $CMD_NAME. Set ENV_SYNC_LEGACY_DIR or install legacy scripts." >&2
    exit 1
fi

if [[ -z "$GO_BIN" ]]; then
    echo "Go binary not found. Build with 'make build' or set ENV_SYNC_GO_BIN to the compiled binary." >&2
    exit 1
fi

exec -a "$CMD_NAME" "$GO_BIN" "$@"
